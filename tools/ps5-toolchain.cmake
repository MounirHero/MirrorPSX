set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER clang-19)
set(CMAKE_CXX_COMPILER clang++-19)
set(CMAKE_C_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_CXX_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_AR llvm-ar-19)
set(CMAKE_RANLIB llvm-ranlib-19)
set(OP "$ENV{OPENPROSPERO_SDK}")
set(COMMON "-fPIC -femulated-tls -fno-stack-protector -nostdinc -isystem /usr/lib/llvm-19/lib/clang/19/include -isystem ${OP}/target/cxx/include -isystem ${OP}/target/include")
set(CMAKE_C_FLAGS_INIT "${COMMON}")
set(CMAKE_CXX_FLAGS_INIT "-fPIC -femulated-tls -fno-stack-protector -fexceptions -funwind-tables -nostdinc -nostdinc++ -isystem ${OP}/target/cxx/include/c++/v1 -isystem ${OP}/target/cxx/include -isystem /usr/lib/llvm-19/lib/clang/19/include -isystem ${OP}/target/include")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-B ${OP}/../build/bin -L ${OP}/target/cxx/lib -lc++ -lc++abi -lunwind")
